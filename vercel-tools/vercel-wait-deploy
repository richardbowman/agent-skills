#!/usr/bin/env bash
# vercel-wait-deploy — wait for the Vercel deployment for a given commit SHA
# to reach success or failure, using the GitHub Deployments API via `gh`.
#
# Usage: vercel-wait-deploy [--cwd <dir>] [--git-cwd <dir>] [--sha <commit-sha>] [--target <env>] [--timeout <seconds>]
#
# Options:
#   --cwd <dir>       Vercel project directory containing .vercel/project.json
#                     (default: $PWD). Used for Vercel CLI calls only.
#   --git-cwd <dir>   Git repo to resolve SHA and branch from (default: same as --cwd).
#                     Pass the worktree path here when --cwd points to the main checkout.
#   --sha <sha>       Git commit SHA to wait for (see SHA resolution below)
#   --target <env>    Environment filter substring, case-insensitive (required)
#   --timeout <secs>  Max seconds to wait (default: 600)
#
# SHA resolution (when --sha is not provided):
#   --target production: uses origin/main — the squash-merge SHA
#   --target preview:    uses the remote tracking branch of the current local
#                        branch in --git-cwd (or --cwd if not set)
#   --sha always overrides the above logic
#
# Outputs the branch-persistent alias URL on success (falls back to hash URL).
# Writes the URL to /tmp/vercel_prod_url.txt on success for subsequent steps.

set -euo pipefail

# Ensure common tool install locations are on PATH
for _dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
  [[ ":$PATH:" != *":$_dir:"* ]] && export PATH="$_dir:$PATH"
done

if ! command -v gh &>/dev/null; then
  echo "Error: 'gh' (GitHub CLI) not found on PATH." >&2
  echo "Install with: brew install gh" >&2
  exit 1
fi

CWD="$PWD"
GIT_CWD=""      # separate git repo path; defaults to CWD if not set
SHA=""
TIMEOUT=600
TARGET=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd)      CWD="$2";     shift 2 ;;
    --git-cwd)  GIT_CWD="$2"; shift 2 ;;
    --sha)      SHA="$2";     shift 2 ;;
    --timeout)  TIMEOUT="$2"; shift 2 ;;
    --target)   TARGET="$2";  shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# Default git repo to the Vercel project dir if not overridden
GIT_CWD="${GIT_CWD:-$CWD}"

if [[ -z "$TARGET" ]]; then
  echo "Error: --target is required. Use --target production or --target preview." >&2
  exit 1
fi

if [[ -z "$SHA" ]]; then
  git -C "$GIT_CWD" fetch origin --quiet 2>/dev/null || true

  TARGET_LC=$(echo "$TARGET" | tr '[:upper:]' '[:lower:]')
  if [[ "$TARGET_LC" == "production" ]]; then
    SHA=$(git -C "$GIT_CWD" rev-parse origin/main 2>/dev/null \
       || git -C "$GIT_CWD" rev-parse origin/HEAD 2>/dev/null \
       || git -C "$GIT_CWD" rev-parse HEAD)
    echo "Resolved production SHA from origin/main"
  else
    LOCAL_BRANCH=$(git -C "$GIT_CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [[ -n "$LOCAL_BRANCH" && "$LOCAL_BRANCH" != "HEAD" ]]; then
      SHA=$(git -C "$GIT_CWD" rev-parse "origin/$LOCAL_BRANCH" 2>/dev/null || echo "")
      [[ -n "$SHA" ]] && echo "Resolved preview SHA from origin/$LOCAL_BRANCH"
    fi
    if [[ -z "$SHA" ]]; then
      SHA=$(git -C "$GIT_CWD" rev-parse HEAD)
      echo "Warning: no remote tracking branch found, using local HEAD" >&2
    fi
  fi
else
  SHA=$(git -C "$GIT_CWD" rev-parse "$SHA" 2>/dev/null || echo "$SHA")
fi

# Derive GitHub repo from the git remote
REPO=$(git -C "$GIT_CWD" remote get-url origin \
  | sed -E 's|.*github\.com[:/]||; s|\.git$||')
if [[ -z "$REPO" ]]; then
  echo "Error: could not determine GitHub repo from $GIT_CWD remote." >&2
  exit 1
fi

# Also grab branch name for alias construction (best-effort)
# Prefer the upstream tracking branch name (the remote branch), since that's what
# Vercel uses for the branch alias URL (e.g. feat/my-branch → -git-feat-my-branch-).
# Fall back to the local branch name if there is no upstream.
_TRACKING=$(git -C "$GIT_CWD" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "")
if [[ -n "$_TRACKING" ]]; then
  # Strip the remote prefix: "origin/feat/my-branch" → "feat/my-branch"
  BRANCH_NAME="${_TRACKING#*/}"
else
  BRANCH_NAME=$(git -C "$GIT_CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
fi

DEADLINE=$(( $(date +%s) + TIMEOUT ))
echo "Waiting for deployment of $SHA in $REPO (target: $TARGET) ..."

# Step 1: Wait for a GitHub deployment to appear
DEPLOY_ID=""
while true; do
  TARGET_LC=$(echo "$TARGET" | tr '[:upper:]' '[:lower:]')
  JQ_FILTER="[.[] | select(.environment | ascii_downcase | contains(\"$TARGET_LC\"))] | .[0].id // empty"
  DEPLOY_ID=$(gh api "repos/$REPO/deployments?sha=$SHA&per_page=20" \
    --jq "$JQ_FILTER" 2>&1) \
    || { echo "  gh api error (will retry): $DEPLOY_ID"; DEPLOY_ID=""; }

  if [[ -n "$DEPLOY_ID" ]]; then
    echo "Found deployment: $DEPLOY_ID"
    break
  fi

  [[ $(date +%s) -ge $DEADLINE ]] && { echo "Timeout: deployment for $SHA never appeared." >&2; exit 1; }
  echo "  deployment not yet registered, retrying in 10s..."
  sleep 10
done

# Step 2: Poll until success/failure
while true; do
  READ=$(gh api "repos/$REPO/deployments/$DEPLOY_ID/statuses?per_page=1" \
    --jq '.[0] | {state: .state, url: (.environment_url // .target_url // "")}' \
    2>/dev/null || echo '{"state":"unknown","url":""}')

  STATUS=$(echo "$READ" | jq -r '.state')
  DEPLOY_URL=$(echo "$READ" | jq -r '.url')

  echo "  status: $STATUS"

  if [[ "$STATUS" == "success" ]]; then
    # Try to get the stable branch alias URL from `vercel ls`
    # Branch aliases look like: {project}-git-{branch-slug}-{team}.vercel.app
    # The hash URL looks like:  {project}-{hash}-{team}.vercel.app
    # We prefer any alias that is NOT the per-deploy hash URL.
    ALIAS_URL=""

    # Method 1: vercel inspect (lists all aliases for the deployment)
    if [[ -n "$DEPLOY_URL" ]]; then
      ALIAS_URL=$(vercel inspect "$DEPLOY_URL" --scope "$(cat "$CWD/.vercel/project.json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('orgId',''))" 2>/dev/null || true)" 2>/dev/null \
        | grep -Eo 'https://[a-zA-Z0-9._-]+\.vercel\.app' \
        | grep -v "$(echo "$DEPLOY_URL" | grep -Eo '[a-zA-Z0-9]+-[a-zA-Z0-9]+-rbcodelabs' | head -1 || true)" \
        | head -1 || true)
    fi

    # Method 2: construct from branch name (reliable when branch name is known)
    # Hash URL pattern: https://{project}-{hash9}-{team}.vercel.app
    # Vercel deploy hashes are always exactly 9 lowercase alphanumeric chars.
    if [[ -z "$ALIAS_URL" && -n "$BRANCH_NAME" && "$BRANCH_NAME" != "HEAD" && "$BRANCH_NAME" != "main" ]]; then
      if [[ "$DEPLOY_URL" =~ https://(.+)-([a-z0-9]{9})-([a-zA-Z0-9-]+)\.vercel\.app ]]; then
        PROJECT_SLUG="${BASH_REMATCH[1]}"
        TEAM_SLUG="${BASH_REMATCH[3]}"
        # Slugify branch: replace / and _ with -, lowercase, truncate to 50 chars
        BRANCH_SLUG=$(echo "$BRANCH_NAME" | tr '[:upper:]' '[:lower:]' | sed 's|[/_]|-|g; s|[^a-z0-9-]||g' | cut -c1-50)
        ALIAS_URL="https://${PROJECT_SLUG}-git-${BRANCH_SLUG}-${TEAM_SLUG}.vercel.app"
        echo "  (constructed branch alias from branch name)"
      fi
    fi

    # Method 3: scan vercel ls for a non-hash URL on this branch
    if [[ -z "$ALIAS_URL" ]]; then
      ALIAS_URL=$(vercel ls --cwd "$CWD" 2>&1 \
        | grep -Eo 'https://[a-zA-Z0-9-]+-git-[a-zA-Z0-9-]+-[a-zA-Z0-9-]+\.vercel\.app' \
        | head -1 || true)
    fi

    OUTPUT_URL="${ALIAS_URL:-$DEPLOY_URL}"
    echo "Deployment ready: $OUTPUT_URL"
    echo "$OUTPUT_URL" > /tmp/vercel_prod_url.txt
    exit 0
  fi

  if [[ "$STATUS" == "failure" || "$STATUS" == "error" ]]; then
    echo "Deployment failed with status: $STATUS" >&2
    exit 1
  fi

  [[ $(date +%s) -ge $DEADLINE ]] && { echo "Timeout waiting for deployment (last status: $STATUS)." >&2; exit 1; }
  sleep 15
done
